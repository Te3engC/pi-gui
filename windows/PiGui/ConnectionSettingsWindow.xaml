<Window x:Class="PiGui.ConnectionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH 连接设置" Width="520" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="DimGray" Margin="0,0,0,14"
      Text="使用 Windows OpenSSH 配置连接。SSH 目标可填写 user@<server-ip>，也可填写 ~/.ssh/config 中的别名。"/>
    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="SSH 目标"/><TextBox x:Name="TargetBox" Grid.Row="1" Grid.Column="1" Margin="8,3"/>
    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="远端工作目录"/><TextBox x:Name="WorkdirBox" Grid.Row="2" Grid.Column="1" Margin="8,3"/>
    <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Pi 程序路径"/><TextBox x:Name="PiPathBox" Grid.Row="3" Grid.Column="1" Margin="8,3"/>
    <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Node 运行时目录"/><TextBox x:Name="NodePathBox" Grid.Row="4" Grid.Column="1" Margin="8,3"/>
    <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="ssh.exe"/><TextBox x:Name="SshPathBox" Grid.Row="5" Grid.Column="1" Margin="8,3"/>
    <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="同步端口"/><TextBox x:Name="SyncPortBox" Grid.Row="6" Grid.Column="1" Margin="8,3"/>
    <TextBlock Grid.Row="7" VerticalAlignment="Center" Text="同步 Token"/><TextBox x:Name="SyncTokenBox" Grid.Row="7" Grid.Column="1" Margin="8,3"/>
    <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="取消" Width="90" IsCancel="True" Margin="0,0,8,0"/>
      <Button Content="保存" Width="90" IsDefault="True" Click="Save_Click"/>
    </StackPanel>
  </Grid>
</Window>
