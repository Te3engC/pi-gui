<Window x:Class="PiGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PiGui.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Pi — Workspace" WindowStyle="None" ResizeMode="CanResize" Icon="Assets/Pi.ico" Height="800" Width="1200" MinHeight="620" MinWidth="1100"
        Closing="Window_Closing" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown"
        Background="#F7F6F2" Foreground="#2B2926" FontFamily="Microsoft YaHei UI">

  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Grid Background="{DynamicResource Canvas}"><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
          <Image Source="Assets/Pi.ico" Width="25" Height="25" Margin="0,0,10,0"/>
          <TextBlock Text="Pi" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Text=" /  Workspace" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Width="46" ToolTip="最小化" Click="Minimize_Click" AutomationProperties.Name="最小化"><Path Data="M 0,5 L 12,5" Stroke="{DynamicResource Ink}" StrokeThickness="1"/></Button>
          <Button Width="46" ToolTip="最大化 / 还原" Click="Maximize_Click" AutomationProperties.Name="最大化或还原"><Path Data="M 0,0 L 10,0 10,10 0,10 Z" Stroke="{DynamicResource Ink}" StrokeThickness="1"/></Button>
          <Button Width="46" ToolTip="关闭" Click="Close_Click" AutomationProperties.Name="关闭"><Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{DynamicResource Ink}" StrokeThickness="1"/></Button>
        </StackPanel>
      </Grid>
    </Border>
  <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <Border x:Name="SidebarBorder" Grid.Column="0" Background="#202020" BorderBrush="#353535" BorderThickness="0,0,1,0" Padding="16">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
          <TextBlock Text="工作空间" FontSize="{DynamicResource Ui18}" FontWeight="SemiBold"/>
          <TextBlock Text="对话 · 代码 · 协作" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource Ui10}" Margin="1,2,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Separator Background="#3A3A3A" Margin="0,12"/>
          <Button Content="↻  刷新对话" HorizontalContentAlignment="Left" Click="RefreshSessionsButton_Click"/>
          <Button Content="⚙  连接设置" HorizontalContentAlignment="Left" Margin="0,8,0,0" Click="SettingsButton_Click"/>
        </StackPanel>
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
          <TextBlock Text="最近对话" FontSize="{DynamicResource Ui12}" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="＋" ToolTip="新建对话" Click="NewSessionButton_Click" IsEnabled="False" x:Name="SidebarNewSessionButton"/>
        </DockPanel>
        <ListBox x:Name="SessionList" SelectionChanged="SessionList_SelectionChanged">
          <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}" FontSize="{DynamicResource Ui12}"/></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <Grid x:Name="ContentPanel" Grid.Column="1" Background="#171717" Margin="0">
      <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border x:Name="HeaderBorder" Grid.Row="0" Background="#1B1B1B" BorderBrush="#353535" BorderThickness="0,0,0,1" Padding="24,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="ConversationTitle" Text="新对话" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" FontSize="{DynamicResource Ui16}" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Margin="0,3,0,0"><Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#717171" Margin="0,3,6,0"/><TextBlock x:Name="StatusText" Text="未连接" FontSize="{DynamicResource Ui11}" Foreground="{DynamicResource Muted}"/></StackPanel>
          </StackPanel>
          <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="CommandButton" Content="/ 命令" Click="CommandButton_Click" Margin="0,0,8,0" ToolTip="打开与 CLI 一致的命令中心"/>
            <Button Content="外观" Click="AppearanceButton_Click" Margin="0,0,8,0"/>
            <ComboBox x:Name="UiSizeBox" Width="88" Margin="0,0,12,0" ToolTip="界面字号（正文在外观中单独设置）" SelectionChanged="UiSizeBox_SelectionChanged"/>
            <Button x:Name="ConnectButton" Content="连接" Click="ConnectButton_Click" Margin="0,0,8,0"/>
            <Button x:Name="NewSessionButton" Content="新对话" Click="NewSessionButton_Click" IsEnabled="False" Margin="0,0,8,0"/>
            <Button x:Name="StopButton" Content="停止" Click="StopButton_Click" IsEnabled="False"/>
          </WrapPanel>
          <StackPanel Visibility="Collapsed"><ComboBox x:Name="FontBox"/><Slider x:Name="FontSizeSlider"/><ComboBox x:Name="FontWeightBox"/><Button x:Name="ThemeButton"/></StackPanel>
        </Grid>
      </Border>

      <Border x:Name="TranscriptBorder" Grid.Row="1" Margin="24,18,24,10" Background="{DynamicResource Canvas}" BorderThickness="0" CornerRadius="10">
        <ScrollViewer x:Name="TranscriptScrollViewer" VerticalScrollBarVisibility="Auto" Padding="10,20" PanningMode="VerticalOnly">
          <ItemsControl x:Name="TranscriptItems" MaxWidth="840" HorizontalAlignment="Stretch" ItemsSource="{Binding ChatMessages, RelativeSource={RelativeSource AncestorType=Window}}" FontFamily="Microsoft YaHei UI" FontSize="14">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type models:ChatLine}">
                <Border x:Name="MessageCard" CornerRadius="12">
                  <Border.RenderTransform><TranslateTransform Y="12"/></Border.RenderTransform>
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Margin" Value="0,0,0,20"/><Setter Property="Padding" Value="16,12"/>
                      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="0"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Role}" Value="你"><Setter Property="Margin" Value="74,0,0,12"/><Setter Property="Padding" Value="16,12,16,13"/><Setter Property="Background" Value="{DynamicResource UserCardBackground}"/><Setter Property="BorderBrush" Value="#C76C4E"/><Setter Property="BorderThickness" Value="1.5"/></DataTrigger>
                        <DataTrigger Binding="{Binding Role}" Value="思考"><Setter Property="Background" Value="{DynamicResource ActivityCardBackground}"/><Setter Property="BorderBrush" Value="#A87FD4"/></DataTrigger>
                        <DataTrigger Binding="{Binding Role}" Value="工具"><Setter Property="Background" Value="{DynamicResource ActivityCardBackground}"/><Setter Property="BorderBrush" Value="#C69D55"/></DataTrigger>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                          <BeginStoryboard>
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/>
                              <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" From="12" To="0" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            </Storyboard>
                          </BeginStoryboard>
                        </EventTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel>
                    <DockPanel LastChildFill="False"><TextBlock Text="{Binding DisplayRole}" FontSize="{DynamicResource Ui10}" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/><TextBlock Text="LIVE" FontSize="{DynamicResource Ui9}" Foreground="#E98262" Margin="8,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsStreaming}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DockPanel>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="24" Margin="0,6,0,0" Foreground="{DynamicResource MessageText}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <Border x:Name="QueuePanel" Grid.Row="2" Margin="24,0,24,8" Padding="9,7" Background="#FBF2E9" BorderBrush="#E4C5A9" BorderThickness="1" CornerRadius="7" Visibility="Collapsed">
        <StackPanel><TextBlock x:Name="QueueText" Text="队列为空" Foreground="#795844" FontSize="{DynamicResource Ui11}"/>
          <Expander Header="查看待处理消息" Margin="0,4,0,0"><ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="QueueDetails" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/></ScrollViewer></Expander>
        </StackPanel>
      </Border>
      <Grid Grid.Row="3" Margin="24,0,24,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border x:Name="AttachmentPanel" Visibility="Collapsed" Grid.Row="0" Margin="0,0,0,8" Padding="8" Background="#202020" BorderBrush="#343434" BorderThickness="1" CornerRadius="8">
          <DockPanel>
            <Button Content="＋" FontSize="{DynamicResource Ui18}" Width="34" Height="30" DockPanel.Dock="Left" Padding="0" Click="AttachButton_Click" ToolTip="选择图片或文件"/>
            <Image x:Name="PreviewImage" Width="75" Height="44" Stretch="Uniform" Margin="8,0,0,0" DockPanel.Dock="Left" Visibility="Collapsed"/>
            <Button x:Name="ClearAttachmentButton" Content="移除" DockPanel.Dock="Right" Click="ClearAttachmentButton_Click" Visibility="Collapsed"/>
            <TextBlock x:Name="AttachmentText" Text="添加图片或文件 · Ctrl+V 粘贴截图" VerticalAlignment="Center" Margin="10,0" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource Ui11}"/>
          </DockPanel>
        </Border>
        <Border x:Name="ComposerBorder" Grid.Row="1" Background="#242424" BorderBrush="#515151" BorderThickness="1" CornerRadius="16" Padding="12">
          <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
            <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource IconButton}" Content="＋" Click="AttachButton_Click" ToolTip="添加附件"/>
            <TextBox x:Name="PromptTextBox" Grid.Row="0" Grid.Column="1" Background="Transparent" BorderThickness="0" GotKeyboardFocus="Composer_GotFocus" LostKeyboardFocus="Composer_LostFocus" CaretBrush="#E67E5F" TextChanged="PromptTextBox_TextChanged" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="150" Padding="8,7" VerticalScrollBarVisibility="Auto" PreviewKeyDown="PromptTextBox_PreviewKeyDown" ToolTip="Enter 发送；Alt+Enter 换行。"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="描述任务，或输入 / 选择命令…" Foreground="{DynamicResource Muted}" Margin="8,9,0,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=PromptTextBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <Button x:Name="SendButton" Grid.Row="0" Grid.Column="2" Content="↑" FontSize="20" Width="42" Height="38" VerticalAlignment="Bottom" Margin="6,0,0,0" Click="SendButton_Click" IsEnabled="False" Background="#C76C4E" BorderBrush="#C76C4E"/>
            <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0"><ComboBox x:Name="ModelBox" Width="220" DisplayMemberPath="Display" IsEnabled="False" SelectionChanged="ModelBox_SelectionChanged" ToolTip="选择当前对话模型"/><ComboBox x:Name="ThinkingBox" Width="105" Margin="7,0,0,0" IsEnabled="False" SelectionChanged="ThinkingBox_SelectionChanged" ToolTip="选择 Pi 思考强度"/>
              <ComboBox x:Name="DeliveryBox" Width="150" Margin="7,0,0,0" SelectedIndex="0" SelectionChanged="DeliveryBox_SelectionChanged" ToolTip="运行期间：等待会在本轮结束后执行；引导会在下个安全执行点介入">
                <ComboBoxItem Content="等待本轮结束"/><ComboBoxItem x:Name="SteerOption" Content="引导当前任务"/>
              </ComboBox>
              <TextBlock x:Name="DeliveryHint" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="10,6" Text="空闲时立即发送"/>
            </WrapPanel>
          </Grid>
        </Border>
        <Popup x:Name="CommandPopup" Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="10" Width="440"><StackPanel><DockPanel Margin="0,0,0,8"><TextBlock Text="命令中心" FontWeight="SemiBold"/><TextBlock Text="Pi commands" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource Ui10}"/></DockPanel><TextBox x:Name="CommandFilterBox" TextChanged="CommandFilterBox_TextChanged" PreviewKeyDown="CommandFilterBox_PreviewKeyDown" Padding="8,5" ToolTip="搜索命令"/><ListBox x:Name="CommandSuggestions" SelectionChanged="CommandSuggestions_SelectionChanged" MaxHeight="240" Margin="0,8,0,0"><ListBox.ItemTemplate><DataTemplate DataType="{x:Type models:CommandItem}"><Grid Margin="5,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontFamily="Cascadia Mono" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource Ui10}" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding SourceLabel}" Foreground="#C76C4E" FontSize="{DynamicResource Ui10}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border></Popup>
      </Grid>
    </Grid>

  </Grid>
  </Grid>
</Window>
