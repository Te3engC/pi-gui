<Window x:Class="PiGui.AppearanceSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="界面设置" Width="360" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"><StackPanel Margin="18"><TextBlock Text="主题"/><ComboBox x:Name="ThemeBox" Margin="0,4,0,12"><ComboBoxItem Content="深色"/><ComboBoxItem Content="浅色"/></ComboBox><TextBlock Text="字体"/><ComboBox x:Name="FontBox" Margin="0,4,0,12"><ComboBoxItem Content="Consolas"/><ComboBoxItem Content="Cascadia Mono"/><ComboBoxItem Content="Microsoft YaHei UI"/></ComboBox><TextBlock Text="字号"/><Slider x:Name="SizeSlider" Minimum="11" Maximum="22" Margin="0,4,0,12"/><TextBlock Text="字重"/><ComboBox x:Name="WeightBox" Margin="0,4,0,16"><ComboBoxItem Content="常规"/><ComboBoxItem Content="加粗"/></ComboBox><Button Content="应用" Click="Apply_Click"/></StackPanel></Window>